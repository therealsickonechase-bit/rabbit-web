NEXT_PUBLIC_SUPABASE_URL=https://ludxbakxpmdqhfgdenwp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used for ingestion, not by the dashboard
SUPABASE_SERVICE_ROLE_KEY=
INGEST_SHARED_SECRET=
KEY_ENCRYPTION_SECRET=
# Optional, only for npm run schema:dump (Supabase > Connect > Session pooler URI)
SUPABASE_DB_URL=
# Public sign-up: Cloudflare Turnstile site key (public) and the Supabase "Send Email" hook secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SEND_EMAIL_HOOK_SECRET=
# Encrypted contact records (created by npm run contacts:keys; the private key is NOT here)
CONTACT_PUBLIC_KEY=
CONTACT_HASH_KEY=
# Optional: the public address used in emailed links (defaults to https://app.rabbitsoftware.io)
APP_URL=
# Optional: set to "off" to stop mirroring the owner's read-only pages to other signed-in accounts
GUEST_MIRROR=
# Optional, only for the concept-map builder (scripts/build-concepts.mjs, scripts/add-umls.ps1): your UMLS API key. Never commit it
UMLS_API_KEY=
