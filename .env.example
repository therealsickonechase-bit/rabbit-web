NEXT_PUBLIC_SUPABASE_URL=https://ludxbakxpmdqhfgdenwp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used for ingestion, not by the dashboard
SUPABASE_SERVICE_ROLE_KEY=
INGEST_SHARED_SECRET=
KEY_ENCRYPTION_SECRET=
# Optional, only for npm run schema:dump (Supabase > Connect > Session pooler URI)
SUPABASE_DB_URL=
# Public sign-up: Cloudflare Turnstile site key (public) and the Supabase "Send Email" hook secret
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SEND_EMAIL_HOOK_SECRET=
# Encrypted contact records (created by npm run contacts:keys; the private key is NOT here)
CONTACT_PUBLIC_KEY=
CONTACT_HASH_KEY=
# Optional: the public address used in emailed links (defaults to https://app.rabbitsoftware.io)
APP_URL=
# Optional: set to "off" to stop mirroring the owner's read-only pages to other signed-in accounts
GUEST_MIRROR=
# Optional, only for the concept-map builder (scripts/build-concepts.mjs, scripts/add-umls.ps1): your UMLS API key. Never commit it
UMLS_API_KEY=
# Owner-only cloud tools. All are server-only; never use NEXT_PUBLIC_ names.
# Leave unset until the separate services are deliberately configured/deployed.
RABBIT_CLOUDSHELL_URL=
RABBIT_CLOUDSHELL_TOKEN=
VAULT_AGENT_URL=
VAULT_AGENT_TOKEN=
# Comma-separated exact subset of: Cloud Agents/Knowledge/,Agents/,Workers/ (trailing slash required).
# Empty fails closed. Do not broaden the upstream allowlist.
VAULT_AGENT_ROOTS=
# Remote integrations default to local-only (locked). Operator selection only.
CLOUD_TOOLS_ACCESS_MODE=local-only
CLOUD_TOOLS_ALLOWED_EMAILS=
# Separate dedicated machine credential; never approval-broker approver credentials.
CLOUD_TOOLS_AGENT_TOKEN=
CLOUD_TOOLS_AGENT_ID=
CLOUD_TOOLS_AGENT_SCOPES=
# Fixed https://<team>.cloudflareaccess.com issuer, application AUD, exact service sub.
CLOUD_TOOLS_ACCESS_ISSUER=
CLOUD_TOOLS_ACCESS_AUD=
CLOUD_TOOLS_ACCESS_AGENT_COMMON_NAME=
# Separately deployed consoles use cloudflare.config.ts modes cloud-supabase/cloud-access,
# independent nonsecret policy objects in src/lib/cloud-deployment.ts and per-Worker secrets.
# Existing/main rabbit-web always binds local-only; browser cannot select a remote mode.
# Deployment authentication/account selection (never put token values in source):
# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN
# Parent machine CLI chooses the appropriate separate console origin via RABBIT_CLOUD_TOOLS_URL.
